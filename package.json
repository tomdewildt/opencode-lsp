{
  "name": "@tomdewildt/opencode-lsp",
  "version": "0.0.0",
  "description": "OpenCode plugin that brings back LSP diagnostics, the lsp tool and an LSP sidebar section for OpenCode v2",
  "keywords": [
    "language-server",
    "lsp",
    "opencode",
    "opencode-plugin",
    "opentui",
    "solidjs"
  ],
  "homepage": "https://github.com/tomdewildt/opencode-lsp",
  "bugs": {
    "url": "https://github.com/tomdewildt/opencode-lsp/issues"
  },
  "license": "MIT",
  "author": "Tom de Wildt",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tomdewildt/opencode-lsp.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/server.js",
    "./tui": "./dist/tui.js"
  },
  "scripts": {
    "build": "bun run build.ts",
    "lint": "oxlint --ignore-pattern='test/e2e/fixtures/files/**' build.ts src/ test/",
    "format": "oxfmt --check build.ts src/ test/",
    "types": "tsc --noEmit",
    "test": "bun run test:unit && bun run test:e2e",
    "test:unit": "bun --config=bunfig.unit.toml test",
    "test:e2e:install": "bun test/e2e/scripts/install-lsp.ts --update",
    "test:e2e": "bun --config=bunfig.e2e.toml test test/e2e"
  },
  "dependencies": {
    "vscode-jsonrpc": "^9.0.3",
    "vscode-languageserver-protocol": "3.18.4",
    "vscode-languageserver-textdocument": "1.0.16"
  },
  "devDependencies": {
    "@opencode/plugin": "^2.0.29",
    "@opentui/core": "^0.6.2",
    "@opentui/solid": "^0.6.2",
    "@types/bun": "^1.4.3",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "solid-js": "^1.9.17",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.25",
    "@opentui/core": ">=0.5.16",
    "@opentui/solid": ">=0.5.16",
    "solid-js": ">=1.9.0"
  }
}
